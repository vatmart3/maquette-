{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/histoire", "destination": "/a-propos", "permanent": true },
    { "source": "/devis", "destination": "/devis-toiture", "permanent": true },
    { "source": "/depannage", "destination": "/depannage-toiture", "permanent": true },
    { "source": "/couvreur-:ville", "destination": "/couvreur/:ville", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
